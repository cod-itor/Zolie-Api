# Copy to .env and fill in. Never commit .env.

# Database (matches the "db" service in compose.yaml)
DB_URL=jdbc:postgresql://localhost:5433/zolie
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Lets Swagger log in with "dev:<name>" tokens instead of Firebase. Keep false in production.
DEV_AUTH_ENABLED=true

# Firebase service account JSON (token verification, push, account deletion). Optional in dev.
FIREBASE_CREDENTIALS_PATH=

# Cloudflare R2 or MinIO. Leave empty in dev to use the built-in fake storage.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_BASE_URL=
